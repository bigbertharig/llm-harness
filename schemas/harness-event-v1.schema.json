{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbertha.local/schemas/harness-event-v1.schema.json",
  "title": "Big Bertha Harness Event v1",
  "type": "object",
  "required": ["schema_version", "event_id", "run_id", "sequence", "type", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": "harness-event/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "type": {"enum": [
      "run.started", "run.succeeded", "run.failed", "run.cancelled", "run.timed_out",
      "model.started", "model.completed", "model.failed", "model.truncated",
      "tool.proposed", "tool.validated", "tool.approved", "tool.executing",
      "tool.committed", "tool.failed", "tool.uncertain", "tool.result_persisted", "tool.result_delivered",
      "compaction.started", "compaction.checkpointed", "compaction.committed", "compaction.aborted",
      "retry.scheduled", "retry.started", "retry.exhausted",
      "child.delegated", "child.completed", "child.failed", "child.cancelled", "child.timed_out",
      "input.queued", "input.steered", "input.applied",
      "job.started", "job.progressed", "job.succeeded", "job.failed",
      "job.cancelled", "job.timed_out"
    ]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "conversation_id": {"type": "string", "minLength": 1},
    "model_step_id": {"type": "string", "minLength": 1},
    "tool_call_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "compaction_id": {"type": "string", "minLength": 1},
    "child_run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
