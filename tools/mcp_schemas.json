            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "tool_profile": {
            "description": "Use workspace_read for current repository files, workspace_git for local history and diffs, public_research for public web evidence, or google_workspace for the dedicated rig account.",
