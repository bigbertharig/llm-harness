# Copy this file to .env on the MAIN Raspberry Pi and fill in the four keys.
# Source it with: set -a; . ./.env; set +a
# Keep .env private (chmod 600 .env). Do not commit it.

SEARXNG_URL=http://127.0.0.1:8888
RIG_SEARCH_PROVIDERS=searxng,duckduckgo,tavily,exa,firecrawl,serpapi
RIG_SEARCH_ROUTING_MODE=fallback

TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=

# Conservative per-provider call caps for the four-query comparison.
# These are local request counts, not account-wide billing controls.
RIG_SEARCH_MONTHLY_CAP_TAVILY=4
RIG_SEARCH_MONTHLY_CAP_EXA=4
RIG_SEARCH_MONTHLY_CAP_FIRECRAWL=4
RIG_SEARCH_MONTHLY_CAP_SERPAPI=4
